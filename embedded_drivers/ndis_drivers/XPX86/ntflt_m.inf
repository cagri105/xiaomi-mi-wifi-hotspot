; -- ntflt_m.inf --
;
; Miniport INF file
;
; ----------------------------------------------------------------------

[Version]
signature  = "$Windows NT$"
Class      = Net
ClassGUID  = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider   = %Company%
DriverVer  = 03/10/2014,1.0.1.0
CatalogFile.ntx86 = ntflt.cat
CatalogFile.ntamd64 = ntflt.cat

[ControlFlags]
ExcludeFromSelect = nt_ndisfiltermp

[DestinationDirs]
DefaultDestDir=12
; No files to copy 

[Manufacturer]
%Company% = Network,NTx86,NTamd64

;For Win2K

[Network]
%Network.DeviceDesc% = NTFLTMP.ndi, nt_ndisfiltermp

;For WinXP and later

[Network.NTx86]
%Network.DeviceDesc% = NTFLTMP.ndi, nt_ndisfiltermp

[Network.NTamd64]
%Network.DeviceDesc% = NTFLTMP.ndi, nt_ndisfiltermp


[NTFLTMP.ndi]
AddReg  = NTFLTMP.ndi.AddReg
Characteristics = 0x29 ;NCF_NOT_USER_REMOVABLE | NCF_VIRTUAL | NCF_HIDDEN

[NTFLTMP.ndi.AddReg]
HKR, Ndi, Service,  0,  ntfiltermp

[NTFLTMP.ndi.Services]
AddService = ntfiltermp,0x2, ntfiltermp.AddService


[ntfiltermp.AddService]
ServiceType    = 1 ;SERVICE_KERNEL_DRIVER
StartType      = 3 ;SERVICE_DEMAND_START
ErrorControl   = 1 ;SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\ntflt.sys
AddReg         = NTFLTMP.AddService.AddReg


[NTFLTMP.AddService.AddReg]
; ----------------------------------------------------------------------
; Add any miniport-specific parameters here.  These are params that your
; filter device is going to use.
;
;HKR, Parameters, ParameterName,  0x10000, "MultiSz", "Parameter", "Value"
;HKR, Parameters, ParameterName2, 0x10001, 4

[Strings]
Company = "Network"
Network.DeviceDesc = "Network Filter Driver Miniport"

[SourceDisksNames]
;None 

[SourceDisksFiles]
;None


